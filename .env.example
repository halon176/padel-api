# Padel API Configuration
# Copy this file to .env and update with your values

# ===========================
# SECURITY (REQUIRED)
# ===========================
# CRITICAL: Generate a strong random secret key for JWT token signing
# Example: openssl rand -hex 32
# Never use the default "secret" value in production!
SECRET_KEY=your-super-secret-key-here-change-me

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===========================
# SERVICE CONFIGURATION
# ===========================
# Port where the API will listen
SERVICE_PORT=8000

# ===========================
# EXTERNAL SERVICES
# ===========================
# URL for the notifications service (email/SMS)
NOTIFICATIONS_URL=http://localhost:7777/v1/email_service
